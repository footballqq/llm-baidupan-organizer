# ==============================================================================
# LLM-BaiduPan-Organizer 全局通用环境变量模板
# 复制为 .env 使用: cp .env.example .env
# ==============================================================================

# 1. 大模型配置 (OpenAI 兼容规范)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-or-proxy-key
LLM_MODEL=gpt-4o-mini

# 2. 本地 Kev 轻量决策模型配置
KEV_BASE_URL=http://127.0.0.1:8008
KEV_MODEL_NAME=0.5b

# 3. AList WebDAV 网关配置
ALIST_PORT=5244
ALIST_MOUNT_PATH=/baiduq
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=admin

# 4. 防风控速率限制配置 (秒)
REQUEST_MIN_DELAY=1.0
REQUEST_MAX_DELAY=2.5
MAX_RETRIES=5
RETRY_BACKOFF=3.0

# 5. 隔离归档根目录
ISOLATION_ROOT_DIR=_待清理隔离区
# DELETE_TARGET_DIR=/_待清理隔离区/03_待删除
