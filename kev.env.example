# ==============================================================================
# Kev 决策模型服务与客户端环境配置示例 (.env.example)
# ==============================================================================

# 服务监听主机与端口
KEV_HOST=127.0.0.1
KEV_PORT=8008
KEV_BASE_URL=http://127.0.0.1:8008

# 运行模式: 'hybrid' (0.5B + 4B 双模型并发常驻), '4b' (仅高精4B), '0.5b' (仅极速0.5B)
KEV_MODEL=hybrid

# 在 hybrid 模式下，当请求未指定 model 时路由的默认模型 (可选 '4b' 或 '0.5b')
KEV_DEFAULT_MODEL=4b
KEV_LIGHT_MODEL=0.5b

# 推理硬件设备 ('cuda', 'cpu')
KEV_DEVICE=cuda

# 模型精度 ('bf16' 或 'fp32')。4B 在 CUDA 强烈推荐使用 bf16 以节省显存
KEV_DTYPE=bf16

# Hugging Face 本地缓存目录重定向（建议指定到本地大容量固态盘）
# HF_HOME=D:\models\hf_cache
